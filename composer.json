{
    "name": "lwekuiper/statamic-hubspot",
    "license": "proprietary",
    "type": "statamic-addon",
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.5"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "description": "Sync Statamic form submissions to HubSpot contacts, with property mapping and consent handling.",
    "keywords": ["statamic", "statamic-addon", "hubspot", "crm", "forms", "marketing"],
    "homepage": "https://github.com/lwekuiper/statamic-hubspot",
    "support": {
        "issues": "https://github.com/lwekuiper/statamic-hubspot/issues",
        "source": "https://github.com/lwekuiper/statamic-hubspot"
    },
    "authors": [
        {
            "name": "Laurens Kuiper",
            "email": "l@urens.me"
        }
    ],
    "autoload": {
        "psr-4": {
            "Lwekuiper\\StatamicHubspot\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lwekuiper\\StatamicHubspot\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Statamic HubSpot",
            "description": "HubSpot integration for Statamic",
            "editions": ["lite", "pro"]
        },
        "laravel": {
            "providers": [
                "Lwekuiper\\StatamicHubspot\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    }
}
